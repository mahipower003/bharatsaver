    "conclusion": {
      "title": "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0940 LIC \u0915\u0935\u0930\u0947\u091c \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u090f\u0902",
      "body": "\u090a\u092a\u0930 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0932\u093e\u0928 \u0928\u0947\u0935\u093f\u0917\u0947\u091f\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0940 \u091a\u0941\u0928\u0940 \u0939\u0941\u0908 LIC \u092a\u0949\u0932\u093f\u0938\u0940 \u0915\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f\u0930 \u092a\u0930 \u0938\u0940\u0927\u0947 \u091c\u093e\u090f\u0902\u0964"
    },
    "disclaimer": "\u0938\u092d\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u0928\u0941\u092e\u093e\u0928 \u0915\u0947\u0935\u0932 \u0938\u093e\u0902\u0915\u0947\u0924\u093f\u0915 \u0939\u0948\u0902\u0964 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0906\u092a\u0915\u0940 \u0906\u092f\u0941, \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u094d\u0932\u093e\u0928 \u0935\u0947\u0930\u093f\u090f\u0902\u091f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092d\u093f\u0928\u094d\u0928 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
